{
  "name": "@workain/dsh-forge",
  "version": "0.1.10",
  "description": "Shared GitHub and GitLab connections with workspace and folder bindings for DSH",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
